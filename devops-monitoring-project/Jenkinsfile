pipeline {
    agent any

    stages {

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t devops-monitoring-app:$BUILD_NUMBER .'
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    docker rm -f monitoring-app || true

                    docker run -d \
                        --name monitoring-app \
                        --restart unless-stopped \
                        -p 5000:5000 \
                        devops-monitoring-app:$BUILD_NUMBER
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'sleep 5'
                sh 'curl --fail http://localhost:5000/health'
            }
        }
    }
}
